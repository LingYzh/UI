{
    "name": "@lingyzh/ui",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "UAH styled Vue component library and standalone documentation",
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/LingYzh/UI.git"
    },
    "exports": {
        ".": "./src/ui/index.ts",
        "./styles.css": "./src/ui/styles.css",
        "./tokens.css": "./src/ui/tokens.css",
        "./preview": "./src/ui/UiPreview.vue",
        "./docs.css": "./src/ui/docs/docs.css",
        "./docs-base.css": "./src/docs-base.css",
        "./docs-content": "./src/ui/docs/content.js",
        "./snackbar": "./src/ui/snackbar.ts"
    },
    "scripts": {
        "dev": "vite --host 127.0.0.1 --port 5174",
        "build": "vite build && vite build --config vite.lib.config.js",
        "typecheck": "node scripts/typecheck.cjs --noEmit -p tsconfig.json",
        "test": "tsx --test tests/*.test.*",
        "preview": "vite preview --host 127.0.0.1 --port 4174",
        "test:ui": "npm run build && node tests/desktop/ui.mjs"
    },
    "peerDependencies": {
        "vue": "^3.5.0"
    },
    "dependencies": {
        "@vuetify/v0": "1.2.3",
        "highlight.js": "11.12.0"
    },
    "devDependencies": {
        "vue": "3.5.43",
        "@vitejs/plugin-vue": "6.0.9",
        "vite": "8.3.1",
        "typescript": "6.0.2",
        "vue-tsc": "3.3.11",
        "tsx": "4.23.15",
        "playwright": "1.63.0",
        "electron": "44.4.5"
    }
}
