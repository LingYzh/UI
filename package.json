{
    "name": "@lingyzh/ui",
    "version": "0.2.2",
    "type": "module",
    "description": "UAH styled Vue component library and standalone documentation",
    "license": "MIT",
    "files": [
        "src/"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/",
        "tag": "latest"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/LingYzh/UI.git"
    },
    "exports": {
        ".": "./src/ui/index.ts",
        "./styles.css": "./src/ui/styles.css",
        "./tokens.css": "./src/ui/tokens.css",
        "./preview": "./src/ui/UiPreview.vue",
        "./docs.css": "./src/ui/docs/docs.css",
        "./docs-base.css": "./src/docs-base.css",
        "./docs-content": "./src/ui/docs/content.js",
        "./snackbar": "./src/ui/snackbar.ts",
        "./diff": "./src/ui/line-diff.ts"
    },
    "scripts": {
        "dev": "vite --host 127.0.0.1 --port 5174",
        "build": "vite build && vite build --config vite.lib.config.js",
        "typecheck": "node scripts/typecheck.cjs --noEmit -p tsconfig.json",
        "test": "tsx --test tests/*.test.*",
        "preview": "vite preview --host 127.0.0.1 --port 4174",
        "test:ui": "npm run build && node tests/desktop/ui.mjs"
    },
    "peerDependencies": {
        "vue": "^3.5.0"
    },
    "dependencies": {
        "@vuetify/v0": "1.2.3",
        "diff": "9.0.0",
        "dompurify": "3.4.16",
        "highlight.js": "11.12.0",
        "katex": "0.18.9",
        "markdown-it": "15.0.2",
        "markdown-it-deflist": "4.0.0",
        "markdown-it-footnote": "4.0.0",
        "markdown-it-mark": "4.0.0",
        "markdown-it-sub": "2.0.0",
        "markdown-it-sup": "2.0.0",
        "markdown-it-task-lists": "2.1.1",
        "mermaid": "11.17.2"
    },
    "devDependencies": {
        "@types/katex": "0.16.8",
        "@vitejs/plugin-vue": "6.0.9",
        "electron": "44.4.5",
        "playwright": "1.63.0",
        "tsx": "4.23.15",
        "typescript": "6.0.2",
        "vite": "8.3.1",
        "vue": "3.5.43",
        "vue-tsc": "3.3.11"
    }
}
